{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/", "dest": "index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sync",   "schedule": "0 8 * * *" },
    { "path": "/api/cron/rerank", "schedule": "0 9 * * *" }
  ]
}
